'use client';

import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { 
  LayoutDashboard, FilePlus, ClipboardList, Users, 
  FileSpreadsheet, CheckCircle2, History, BarChart3, 
  Settings, Building2, ExternalLink 
} from 'lucide-react';

const navItems = [
  { href: '/', label: 'Dashboard', icon: LayoutDashboard },
  { href: '/nueva-solicitud', label: 'Nueva solicitud', icon: FilePlus },
  { href: '/solicitudes/sample-id', label: 'Solicitudes', icon: ClipboardList },
  { href: '/proveedores', label: 'Proveedores', icon: Users },
  { href: '/solicitudes/sample-id', label: 'Cotizaciones', icon: FileSpreadsheet },
  { href: '/solicitudes/sample-id/orden-trabajo', label: 'Trabajos adjudicados', icon: CheckCircle2 },
  { href: '#', label: 'Historial', icon: History },
  { href: '/reportes', label: 'Reportes', icon: BarChart3 },
  { href: '#', label: 'Configuración', icon: Settings },
];

export function Sidebar() {
  const pathname = usePathname();

  return (
    <aside className="w-64 bg-slate-900 text-slate-100 flex flex-col h-screen fixed top-0 left-0 border-r border-slate-800 z-50">
      <div className="p-5 flex items-center gap-3 border-b border-slate-800">
        <div className="p-2 bg-hospital-500 rounded-lg">
          <Building2 className="w-6 h-6 text-white" />
        </div>
        <div>
          <h1 className="font-bold text-lg leading-tight">HospitalPro</h1>
          <p className="text-xs text-slate-400">Servicios Generales</p>
        </div>
      </div>

      <nav className="flex-1 overflow-y-auto py-4 px-3 space-y-1">
        {navItems.map((item) => {
          const Icon = item.icon;
          const isActive = pathname === item.href;
          return (
            <Link
              key={item.label}
              href={item.href}
              className={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
                isActive 
                  ? 'bg-hospital-500 text-white shadow-md' 
                  : 'text-slate-300 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <Icon className="w-5 h-5" />
              <span>{item.label}</span>
            </Link>
          );
        })}
      </nav>

      <div className="p-4 border-t border-slate-800">
        <Link 
          href="/proveedor-portal"
          className="flex items-center justify-between w-full px-3 py-2 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs font-semibold text-hospital-500 transition-colors"
        >
          <span>Vista Proveedor</span>
          <ExternalLink className="w-4 h-4" />
        </Link>
      </div>
    </aside>
  );
}
