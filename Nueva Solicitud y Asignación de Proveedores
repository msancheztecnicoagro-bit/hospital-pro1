// src/app/nueva-solicitud/page.tsx
'use client';

import { useState } from 'react';
import { Upload, CheckSquare, Send, AlertTriangle } from 'lucide-react';
import { PrioridadType } from '@/lib/types';

export default function NuevaSolicitudPage() {
  const [step, setStep] = useState<'form' | 'suppliers'>('form');
  const [prioridad, setPrioridad] = useState<PrioridadType>('Media');
  const [selectedSuppliers, setSelectedSuppliers] = useState<string[]>([]);
  const [files, setFiles] = useState<File[]>([]);

  const toggleSupplier = (id: string) => {
    setSelectedSuppliers(prev => 
      prev.includes(id) ? prev.filter(s => s !== id) : [...prev, id]
    );
  };

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files) {
      setFiles(Array.from(e.target.files));
    }
  };

  return (
    <div className="max-w-4xl mx-auto space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-slate-900 dark:text-white">
          {step === 'form' ? 'Crear Requerimiento de Trabajo' : 'Asignar Proveedores al Trabajo'}
        </h1>
        <p className="text-sm text-slate-500">
          {step === 'form' 
            ? 'Ingresa especificaciones técnicas, prioridad y ubicación hospitalaria.' 
            : 'Selecciona las empresas para notificar el requerimiento e iniciar cotización.'}
        </p>
      </div>

      {step === 'form' ? (
        <div className="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 space-y-6">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="md:col-span-2">
              <label className="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase">Título del Trabajo</label>
              <input 
                type="text" 
                placeholder="Ej: Mantenimiento Preventivo Chiller Central - UTI"
                className="w-full mt-1 px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-slate-50 dark:bg-slate-700"
              />
            </div>

            <div className="md:col-span-2">
              <label className="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase">Descripción Detallada</label>
              <textarea 
                rows={4} 
                placeholder="Especificar alcance técnico, horarios permitidos, protocolos de ruido y precauciones sanitarias..."
                className="w-full mt-1 px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-slate-50 dark:bg-slate-700"
              />
            </div>

            <div>
              <label className="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase">Categoría</label>
              <select className="w-full mt-1 px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-slate-50 dark:bg-slate-700">
                <option>Climatización</option>
                <option>Electricidad</option>
                <option>Equipos médicos</option>
                <option>Gasfitería</option>
                <option>Redes sanitarias</option>
              </select>
            </div>

            <div>
              <label className="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase">Prioridad Hospitalaria</label>
              <div className="grid grid-cols-4 gap-2 mt-1">
                {(['Crítica', 'Alta', 'Media', 'Baja'] as PrioridadType[]).map((level) => (
                  <button
                    key={level}
                    type="button"
                    onClick={() => setPrioridad(level)}
                    className={`py-1.5 rounded-lg text-xs font-bold border transition-all ${
                      prioridad === level 
                        ? level === 'Crítica' ? 'bg-red-600 text-white border-red-600' : 'bg-hospital-500 text-white border-hospital-500' 
                        : 'border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300'
                    }`}
                  >
                    {level}
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label className="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase">Ubicación / Piso</label>
              <input type="text" placeholder="Ej: Torre A - Piso 3" className="w-full mt-1 px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-slate-50 dark:bg-slate-700" />
            </div>

            <div>
              <label className="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase">Servicio Clínico / Unidad</label>
              <input type="text" placeholder="Ej: Unidad de Cuidados Intensivos (UCI)" className="w-full mt-1 px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-slate-50 dark:bg-slate-700" />
            </div>

            <div>
              <label className="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase">Fecha Límite Cotización</label>
              <input type="datetime-local" className="w-full mt-1 px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-slate-50 dark:bg-slate-700" />
            </div>

            <div>
              <label className="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase">Tipo de Presupuesto</label>
              <select className="w-full mt-1 px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-slate-50 dark:bg-slate-700">
                <option value="Abierto">Abierto (A cotizar)</option>
                <option value="Estimado">Estimado ($ CLP)</option>
                <option value="Reservado">Reservado / Interno</option>
              </select>
            </div>
          </div>

          {/* Subida de Adjuntos Técnicos */}
          <div className="border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-xl p-6 text-center">
            <input 
              type="file" 
              multiple 
              onChange={handleFileChange} 
              className="hidden" 
              id="file-upload" 
            />
            <label htmlFor="file-upload" className="cursor-pointer">
              <Upload className="w-8 h-8 text-hospital-500 mx-auto mb-2" />
              <p className="text-sm font-medium text-slate-800 dark:text-slate-200">
                Haz clic para subir fotografías, planos (DWG/PDF) o especificaciones
              </p>
              <p className="text-xs text-slate-400 mt-1">Soporta PDF, PNG, JPG, MP4 hasta 50MB</p>
            </label>
            {files.length > 0 && (
              <div className="mt-4 flex flex-wrap gap-2 justify-center">
                {files.map((file, idx) => (
                  <span key={idx} className="px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-xs">
                    {file.name}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div className="flex justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
            <button 
              type="button"
              onClick={() => setStep('suppliers')} 
              className="bg-hospital-500 hover:bg-hospital-700 text-white px-6 py-2 rounded-lg text-sm font-semibold transition-colors"
            >
              Continuar a Selección de Proveedores
            </button>
          </div>
        </div>
      ) : (
        /* Paso 2: Selección Múltiple de Proveedores */
        <div className="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 space-y-6">
          <div className="flex items-center justify-between">
            <p className="text-sm font-semibold text-slate-700 dark:text-slate-300">
              Proveedores filtrados automáticamente por especialidad: <span className="text-hospital-500 font-bold">Climatización</span>
            </p>
            <span className="text-xs bg-hospital-50 text-hospital-500 px-3 py-1 rounded-full font-bold">
              {selectedSuppliers.length} proveedores seleccionados
            </span>
          </div>

          <div className="space-y-3">
            {[
              { id: '1', nombre: 'ClimaMed Ltda.', eval: 4.9, cert: true },
              { id: '2', nombre: 'TermoClima Global S.A.', eval: 4.6, cert: true },
              { id: '3', nombre: 'Servicios de Aire Ingeniería', eval: 4.4, cert: false }
            ].map((s) => (
              <div 
                key={s.id}
                onClick={() => toggleSupplier(s.id)}
                className={`p-4 rounded-lg border cursor-pointer flex items-center justify-between transition-all ${
                  selectedSuppliers.includes(s.id)
                    ? 'border-hospital-500 bg-blue-50/50 dark:bg-blue-900/10'
                    : 'border-slate-200 dark:border-slate-700 hover:border-slate-300'
                }`}
              >
                <div className="flex items-center gap-3">
                  <CheckSquare className={`w-5 h-5 ${selectedSuppliers.includes(s.id) ? 'text-hospital-500' : 'text-slate-300'}`} />
                  <div>
                    <p className="font-semibold text-sm text-slate-900 dark:text-white">{s.nombre}</p>
                    <p className="text-xs text-slate-500">Evaluación histórica: ★ {s.eval}</p>
                  </div>
                </div>
                {s.cert && (
                  <span className="text-xs bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300 px-2.5 py-0.5 rounded-full">
                    Certificado Hospitalario SEC
                  </span>
                )}
              </div>
            ))}
          </div>

          <div className="flex justify-between items-center pt-4 border-t border-slate-200 dark:border-slate-700">
            <button 
              type="button" 
              onClick={() => setStep('form')} 
              className="text-slate-500 hover:text-slate-700 text-sm font-semibold"
            >
              Volver atrás
            </button>
            <button 
              type="button"
              className="bg-hospital-500 hover:bg-hospital-700 text-white px-6 py-2 rounded-lg text-sm font-semibold flex items-center gap-2"
            >
              <Send className="w-4 h-4" /> Enviar Solicitud y Notificar por Correo
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
